# Node modules
node_modules/

# Next.js build output
.next/
out/
.next/cache/

# Production build artifacts
dist/
build/

# Environment variable files
.env
.env.*
!.env.example

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor folders
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# ESLint cache
.eslintcache

# Miscellaneous
*.swp
*.swo
*.bak
*.orig

# Docker files generated locally
docker-compose.override.yml

# Local configuration files
*.local

# End of .gitignore */