{
  "name": "pulseforge-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for PulseForge – AI‑powered CI/CD observability platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:unit": "jest --coverage",
    "test:e2e": "cypress open",
    "test:e2e:run": "cypress run",
    "prepare": "husky install"
  },
  "dependencies": {
    "next": "13.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "axios": "^1.6.0",
    "swr": "^2.2.0",
    "recharts": "^2.12.2",
    "tailwindcss": "^3.3.3",
    "postcss": "^8.4.27",
    "autoprefixer": "^10.4.14",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "20.8.0",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.2",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.48.0",
    "eslint-config-next": "13.5.6",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "cypress": "^13.6.0",
    "cypress-mochawesome-reporter": "^3.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "components/**/*.tsx",
      "pages/**/*.tsx",
      "!**/node_modules/**",
      "!**/*.d.ts"
    ]
  },
  "cypress": {
    "baseUrl": "http://localhost:3000",
    "video": false,
    "screenshotsFolder": "cypress/screenshots",
    "videosFolder": "cypress/videos"
  },
  "engines": {
    "node": ">=18"
  }
}